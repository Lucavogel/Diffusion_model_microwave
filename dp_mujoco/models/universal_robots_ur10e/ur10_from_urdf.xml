<mujoco model="ur10_with_rg2ft">
  <compiler angle="radian" autolimits="true"/>

  <option integrator="implicitfast"/>

  <asset>
    <!-- UR10 robot meshes -->
    <mesh name="base" content_type="model/stl" file="base.stl"/>
    <mesh name="shoulder" content_type="model/stl" file="shoulder.stl"/>
    <mesh name="upperarm" content_type="model/stl" file="upperarm.stl"/>
    <mesh name="forearm" content_type="model/stl" file="forearm.stl"/>
    <mesh name="wrist1" content_type="model/stl" file="wrist1.stl"/>
    <mesh name="wrist2" content_type="model/stl" file="wrist2.stl"/>
    <mesh name="wrist3" content_type="model/stl" file="wrist3.stl"/>

    <!-- RG2FT gripper meshes -->
    <mesh name="quick_changer"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/quick_changer.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="gripper_body"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/gripper_body.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="angle_bracket"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/angle_bracket.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="left_inner_knuckle"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/left_inner_knuckle.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="right_outer_knuckle"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/right_outer_knuckle.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="left_outer_knuckle"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/left_outer_knuckle.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="left_inner_finger"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/left_inner_finger.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="right_inner_finger"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/right_inner_finger.stl"
          scale="0.001 0.001 0.001"/>

    <mesh name="right_inner_knuckle"
          content_type="model/stl"
          file="../pince/OnRobot-RG2FT-ROS/onrobot_rg2ft_description/urdf/right_inner_knuckle.stl"
          scale="0.001 0.001 0.001"/>

    <!-- Better-looking materials -->
    <material name="ur_dark"
              rgba="0.16 0.16 0.17 1"
              specular="0.35"
              shininess="0.25"/>

    <material name="ur_light"
              rgba="0.78 0.78 0.76 1"
              specular="0.35"
              shininess="0.22"/>

    <material name="ur_blue"
              rgba="0.08 0.42 0.72 1"
              specular="0.35"
              shininess="0.25"/>

    <material name="ur_black"
              rgba="0.03 0.03 0.035 1"
              specular="0.2"
              shininess="0.2"/>

    <material name="gripper_gray"
              rgba="0.62 0.62 0.60 1"
              specular="0.35"
              shininess="0.25"/>

    <material name="gripper_dark"
              rgba="0.18 0.18 0.18 1"
              specular="0.25"
              shininess="0.2"/>

    <material name="gripper_blue"
              rgba="0.05 0.36 0.62 1"
              specular="0.35"
              shininess="0.25"/>
  </asset>

  <worldbody>
    <light name="spotlight"
           mode="targetbodycom"
           target="wrist_2_link"
           pos="0 -1 2"/>

    <body name="base" pos="0 0 0.4" quat="1 0 0 0">
      <geom quat="-1 0 0 0"
            type="mesh"
            mesh="base"
            material="ur_dark"
            contype="0"
            conaffinity="0"/>

      <body name="shoulder_link" pos="0 0 0.1273" quat="0 0 0 1" gravcomp="1">
        <inertial pos="0.021 -0.027 0"
                  quat="0.988634 -0.000680926 0.148578 -0.0229591"
                  mass="7.1"
                  diaginertia="0.0353866 0.0352903 0.0202532"/>

        <joint name="shoulder_pan_joint"
               pos="0 0 0"
               axis="0 0 1"
               range="-6.28319 6.28319"
               actuatorfrcrange="-330 330"
               damping="10"
               armature="0.08"/>

        <geom quat="0 0 0 1"
              type="mesh"
              mesh="shoulder"
              material="ur_blue"
              contype="0"
              conaffinity="0"/>

        <body name="upper_arm_link" quat="0.707107 0.707107 0 0" gravcomp="1">
          <inertial pos="-0.232 0 0.158"
                    quat="0.500033 0.499784 0.489585 0.510381"
                    mass="12.7"
                    diaginertia="0.77068 0.769758 0.0278114"/>

          <joint name="shoulder_lift_joint"
                 pos="0 0 0"
                 axis="0 0 1"
                 range="-6.28319 6.28319"
                 actuatorfrcrange="-330 330"
                 damping="20"
                 armature="0.15"/>

          <geom pos="0 0 0.220941"
                quat="0.5 0.5 -0.5 -0.5"
                type="mesh"
                mesh="upperarm"
                material="ur_light"
                contype="0"
                conaffinity="0"/>

          <body name="forearm_link" pos="-0.612 0 0" gravcomp="1">
            <inertial pos="-0.3323 0 0.068"
                      quat="0.492051 0.507971 0.507346 0.492394"
                      mass="4.27"
                      diaginertia="0.30928 0.306743 0.00985709"/>

            <joint name="elbow_joint"
                   pos="0 0 0"
                   axis="0 0 1"
                   range="-3.14159 3.14159"
                   actuatorfrcrange="-150 150"
                   damping="16"
                   armature="0.12"/>

            <geom pos="0 0 0.049042"
                  quat="0.5 0.5 -0.5 -0.5"
                  type="mesh"
                  mesh="forearm"
                  material="ur_light"
                  contype="0"
                  conaffinity="0"/>

            <body name="wrist_1_link" pos="-0.5723 0 0.163941" gravcomp="1">
              <inertial pos="0 -0.018 0.007"
                        quat="0.525776 0.850564 -0.0100431 9.45801e-05"
                        mass="2"
                        diaginertia="0.00296017 0.00269992 0.00209991"/>

              <joint name="wrist_1_joint"
                     pos="0 0 0"
                     axis="0 0 1"
                     range="-6.28319 6.28319"
                     actuatorfrcrange="-56 56"
                     damping="8"
                     armature="0.06"/>

              <geom pos="0 0 -0.1149"
                    quat="0.707107 0.707107 0 0"
                    type="mesh"
                    mesh="wrist1"
                    material="ur_dark"
                    contype="0"
                    conaffinity="0"/>

              <body name="wrist_2_link" pos="0 -0.1157 -2.37305e-11" quat="0.707107 0.707107 0 0" gravcomp="1">
                <inertial pos="0 0.018 -0.007"
                          quat="0.525776 0.850564 -0.0100431 9.45801e-05"
                          mass="2"
                          diaginertia="0.00296017 0.00269992 0.00209991"/>

                <joint name="wrist_2_joint"
                       pos="0 0 0"
                       axis="0 0 1"
                       range="-6.28319 6.28319"
                       actuatorfrcrange="-56 56"
                       damping="6"
                       armature="0.05"/>

                <geom pos="0 0 -0.1158"
                      quat="1 0 0 0"
                      type="mesh"
                      mesh="wrist2"
                      material="ur_dark"
                      contype="0"
                      conaffinity="0"/>

                <body name="wrist_3_link" pos="0 0.0922 -1.89105e-11" quat="0.707107 -0.707107 0 0" gravcomp="1">
                  <inertial pos="0 0 -0.026"
                            quat="0.707107 0 0 0.707107"
                            mass="0.365"
                            diaginertia="0.00041 0.0004 0.00034"/>

                  <joint name="wrist_3_joint"
                         pos="0 0 0"
                         axis="0 0 1"
                         range="-6.28319 6.28319"
                         actuatorfrcrange="-56 56"
                         damping="4"
                         armature="0.03"/>

                  <geom pos="0 0 -0.0922"
                        quat="0.707107 0.707107 0 0"
                        type="mesh"
                        mesh="wrist3"
                        material="ur_light"
                        contype="0"
                        conaffinity="0"/>

                  <site name="attachment_site"
                        pos="0 0 0"
                        size="0.005"
                        rgba="1 0 0 1"/>

                  
                  

                  <!-- Bonne pose validée pour la pince -->
                  <body name="rg2ft_gripper" pos="0 0 -0.1" quat="1 0 0 0">

                        <camera name="wrist_cam"
                              pos="0 0.08 0.12"
                              xyaxes="-1 0 0 0 1 0"
                              fovy="70"/>

                        <geom pos="0 0 0.1"
                              quat="1 0 0 0"
                              type="mesh"
                              material="gripper_blue"
                              mesh="quick_changer"
                              contype="0"
                              conaffinity="0"/>

                    <geom pos="0 0 0.1"
                          quat="1 0 0 0"
                          type="mesh"
                          material="gripper_dark"
                          mesh="angle_bracket"
                          contype="0"
                          conaffinity="0"/>

                    <geom pos="0 0.000475769 0.100002"
                          quat="0.999987 0.00506143 0 0"
                          type="mesh"
                          material="gripper_gray"
                          mesh="gripper_body"
                          contype="0"
                          conaffinity="0"/>

                    <body name="right_outer_knuckle"
                          pos="-0.017 -0.0103018 0.222798"
                          quat="0.978496 0.00495266 -0.206202 -0.00104369">

                      <inertial pos="-0.0123122 0.0103697 0.0102038"
                                quat="0 0.92388 0 0.382683"
                                mass="0.0415837"
                                diaginertia="1.7e-05 1.6e-05 3e-06"/>

                      <joint name="finger_joint"
                             pos="0 0 0"
                             axis="0 0.999949 -0.010122"
                             range="-0.2 1.2"
                             actuatorfrcrange="-50 50"
                             damping="5"
                             armature="0.05"/>

                      <geom pos="0.017 0.009534 -0.122898"
                            type="mesh"
                            material="gripper_dark"
                            mesh="right_outer_knuckle"
                            contype="0"
                            conaffinity="1"/>

                      <body name="right_inner_finger"
                            pos="-0.039748 0.004784 0.037968"
                            quat="0.978509 0 0.206204 0">

                        <joint name="right_inner_finger_joint"
                               pos="0 0 0"
                               axis="0 0.999949 -0.010122"
                               range="-1.68 0.2"
                               damping="5"
                               armature="0.05"/>

                        <geom pos="0.056748 0.00475 -0.160866"
                              type="mesh"
                              material="gripper_gray"
                              mesh="right_inner_finger"
                              contype="0"
                              conaffinity="1"
                              friction="3.0 0.1 0.002"
                              solimp="0.99 0.999 0.001"
                              solref="0.004 1"
                              margin="0.001"
                              condim="4"/>
                      </body>
                    </body>

                    <body name="left_outer_knuckle"
                          pos="0.017 -0.0103018 0.222798"
                          quat="0.978496 0.00495266 0.206202 0.00104369">

                      <inertial pos="0.012312 0.0103697 0.0102038"
                                quat="0.92388 0 0.382683 0"
                                mass="0.0415837"
                                diaginertia="1.7e-05 1.6e-05 3e-06"/>

                      <joint name="left_outer_knuckle_joint"
                             pos="0 0 0"
                             axis="0 0.999949 -0.010122"
                             range="-1.69 0.21"
                             actuatorfrcrange="-50 50"
                             damping="5"
                             armature="0.05"/>

                      <geom pos="-0.017 0.009534 -0.122898"
                            type="mesh"
                            material="gripper_dark"
                            mesh="left_outer_knuckle"
                            contype="0"
                            conaffinity="1"/>

                      <body name="left_inner_finger"
                            pos="0.039748 0.004784 0.037968"
                            quat="0.978509 0 -0.206204 0">

                        <joint name="left_inner_finger_joint"
                               pos="0 0 0"
                               axis="0 0.999949 -0.010122"
                               range="-0.2 1.68"
                               damping="5"
                               armature="0.05"/>

                        <geom pos="-0.056748 0.00475 -0.160866"
                              type="mesh"
                              material="gripper_gray"
                              mesh="left_inner_finger"
                              contype="0"
                              conaffinity="1"
                              friction="3.0 0.1 0.002"
                              solimp="0.99 0.999 0.001"
                              solref="0.004 1"
                              margin="0.001"
                              condim="4"/>
                      </body>
                    </body>

                    <body name="left_inner_knuckle"
                          pos="0.0075 -0.0103018 0.239297"
                          quat="0.978496 0.00495266 0.206202 0.00104369">

                      <inertial pos="0.0176 0.0104 0.017"
                                mass="0.024"
                                diaginertia="5e-6 7e-6 5e-6"/>

                      <joint name="left_inner_knuckle_joint"
                             pos="0 0 0"
                             axis="0 0.999949 -0.010122"
                             range="-1.69 0.21"
                             damping="5"
                             armature="0.05"/>

                      <geom pos="-0.0075 0.009367 -0.139397"
                            quat="1 0 0 0"
                            type="mesh"
                            material="gripper_dark"
                            mesh="left_inner_knuckle"
                            contype="0"
                            conaffinity="1"/>
                    </body>

                    <body name="right_inner_knuckle"
                          pos="-0.0075 -0.0103018 0.239297"
                          quat="0.978496 0.00495266 -0.206202 -0.00104369">

                      <inertial pos="-0.0176 0.0104 0.017"
                                mass="0.024"
                                diaginertia="5e-6 7e-6 5e-6"/>

                      <joint name="right_inner_knuckle_joint"
                             pos="0 0 0"
                             axis="0 0.999949 -0.010122"
                             range="-0.2 1.68"
                             damping="5"
                             armature="0.05"/>

                      <geom pos="0.0075 0.009367 -0.139397"
                            quat="1 0 0 0"
                            type="mesh"
                            material="gripper_dark"
                            mesh="right_inner_knuckle"
                            contype="0"
                            conaffinity="1"/>
                    </body>

                    <site name="grasp_site"
                          pos="0 0 0.31"
                          size="0.01"
                          rgba="0 1 0 1"
                          group="1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
  <general name="shoulder_pan"
           joint="shoulder_pan_joint"
           biastype="affine"
           gainprm="2200 0 0"
           biasprm="0 -2200 -250"
           ctrlrange="-6.28319 6.28319"
           forcerange="-1000 1000"/>

  <general name="shoulder_lift"
           joint="shoulder_lift_joint"
           biastype="affine"
           gainprm="4500 0 0"
           biasprm="0 -4500 -500"
           ctrlrange="-6.28319 6.28319"
           forcerange="-1800 1800"/>

  <general name="elbow"
           joint="elbow_joint"
           biastype="affine"
           gainprm="3500 0 0"
           biasprm="0 -3500 -400"
           ctrlrange="-3.14159 3.14159"
           forcerange="-1400 1400"/>

  <general name="wrist_1"
           joint="wrist_1_joint"
           biastype="affine"
           gainprm="1400 0 0"
           biasprm="0 -1400 -180"
           ctrlrange="-6.28319 6.28319"
           forcerange="-500 500"/>

  <general name="wrist_2"
           joint="wrist_2_joint"
           biastype="affine"
           gainprm="1200 0 0"
           biasprm="0 -1200 -160"
           ctrlrange="-6.28319 6.28319"
           forcerange="-450 450"/>

  <general name="wrist_3"
           joint="wrist_3_joint"
           biastype="affine"
           gainprm="900 0 0"
           biasprm="0 -900 -120"
           ctrlrange="-6.28319 6.28319"
           forcerange="-300 300"/>

  <position name="gripper_motor"
            joint="finger_joint"
            ctrlrange="-0.2 1.2"
            kp="1000"
            forcerange="-150 150"/>
</actuator>

  <equality>
    <joint name="mimic_left_outer"
           joint1="finger_joint"
           joint2="left_outer_knuckle_joint"
           polycoef="0 -1 0 0 0"
           solimp="0.99 0.99 0.001"
           solref="0.005 1"/>

    <joint name="mimic_right_inner"
           joint1="finger_joint"
           joint2="right_inner_knuckle_joint"
           polycoef="0 1 0 0 0"
           solimp="0.99 0.99 0.001"
           solref="0.005 1"/>

    <joint name="mimic_right_finger"
           joint1="finger_joint"
           joint2="right_inner_finger_joint"
           polycoef="0 -1 0 0 0"
           solimp="0.99 0.99 0.001"
           solref="0.005 1"/>

    <joint name="mimic_left_inner"
           joint1="finger_joint"
           joint2="left_inner_knuckle_joint"
           polycoef="0 -1 0 0 0"
           solimp="0.99 0.99 0.001"
           solref="0.005 1"/>

    <joint name="mimic_left_finger"
           joint1="finger_joint"
           joint2="left_inner_finger_joint"
           polycoef="0 1 0 0 0"
           solimp="0.99 0.99 0.001"
           solref="0.005 1"/>
  </equality>

  <keyframe>
    <key name="home"
         qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0 0 0 0 0 0"
         ctrl="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0"/>
  </keyframe>
</mujoco>