<mujoco model="minimal tutorial scene">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <light name="key_light" pos="0 -0.5 1.5"/>
    <geom name="floor" type="plane" size="1 1 0.05"
          rgba="0.85 0.85 0.85 1"/>

    <body name="arm" pos="0 0 0.08">
      <joint name="arm_hinge" type="hinge" axis="0 1 0"
             range="-1.57 1.57" damping="0.2"/>
      <geom name="arm_geom" type="capsule"
            fromto="0 0 0 0 0 0.35" size="0.025" mass="0.5"
            rgba="0.15 0.45 0.80 1"/>
      <site name="tool_site" pos="0 0 0.35" size="0.015"
            rgba="0.90 0.10 0.10 1"/>
    </body>

    <body name="free_cube" pos="0.28 0 0.25">
      <freejoint/>
      <geom name="cube_geom" type="box" size="0.04 0.04 0.04"
            mass="0.1" rgba="0.15 0.70 0.30 1"/>
    </body>

    <camera name="overview" mode="targetbody" target="arm"
            pos="1.0 -1.0 0.8"/>
  </worldbody>

  <actuator>
    <position name="arm_position" joint="arm_hinge"
              kp="20" ctrlrange="-1.2 1.2"/>
  </actuator>
</mujoco>
